CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000
# A handshake's elliptic-curve arithmetic needs more stack than the main task's default 3.5 KB
# (tern/contact.h). The demo's 'selftest' command reports how much is left.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Optimised for speed: the core's portable elliptic-curve arithmetic is several times slower at
# ESP-IDF's default, -Og, and a handshake is mostly that arithmetic.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The companion link over Bluetooth LE (main/ble.c): NimBLE, one peripheral connection, frames of
# up to 180 bytes in one notification, and only LE Secure Connections pairing with a passkey, its
# bonds kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
