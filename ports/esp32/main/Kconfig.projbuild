menu "Tern demo"

    choice TERN_BOARD
        prompt "Board"
        default TERN_BOARD_HELTEC_V3
        help
            The board the image is for: its pins and what it has fitted (main/boards.c). An
            image for one board does not run on another. boards/<name>.defaults sets this with
            the rest of what the board needs, such as its console: build with
            ./build.sh <name>.

        config TERN_BOARD_HELTEC_V3
            bool "Heltec WiFi LoRa 32 V3"
        config TERN_BOARD_HELTEC_V4
            bool "Heltec WiFi LoRa 32 V4 (V4.2 and V4.3)"
    endchoice

    config TERN_BOARD_NAME
        string
        default "heltec-v3" if TERN_BOARD_HELTEC_V3
        default "heltec-v4" if TERN_BOARD_HELTEC_V4

    rsource "../../node/Kconfig.tern"

endmenu
