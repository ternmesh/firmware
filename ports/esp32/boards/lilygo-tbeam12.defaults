# The LilyGo T-Beam V1.2: a classic ESP32 with 4 MB of flash, so the smaller slots
# (partitions-4mb.csv). Its console is UART0, through the board's USB-to-serial chip.
CONFIG_IDF_TARGET="esp32"
CONFIG_TERN_BOARD_LILYGO_TBEAM12=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-4mb.csv"
